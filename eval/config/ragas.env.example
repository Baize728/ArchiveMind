# Copy this file to eval/config/ragas.env and fill in your local values.
# eval/config/ragas.env is git-ignored and must not be committed.

# Required. Use an OpenAI key or an OpenAI-compatible gateway key.
OPENAI_API_KEY=

# Optional. Set this when using an OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

RAGAS_LLM_PROVIDER=openai
RAGAS_LLM_MODEL=gpt-4o-mini
RAGAS_EMBEDDING_PROVIDER=openai
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
# Optional. Use when your embedding model supports explicit dimensions.
# RAGAS_EMBEDDING_DIMENSION=2048
RAGAS_TEMPERATURE=0
RAGAS_METRICS=faithfulness,answer_relevancy,context_precision,context_recall

# Optional. Use these only if your chat gateway does not provide embeddings.
# RAGAS_EMBEDDING_API_KEY=your-embedding-api-key
# RAGAS_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
